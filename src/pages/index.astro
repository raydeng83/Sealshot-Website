---
import SiteLayout from '../layouts/SiteLayout.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import '@splidejs/splide/css';
import {
  activeOffer, formatUSDCompact, REGULAR_PRICE_CENTS, REGULAR_UPDATE_MONTHS, TRIAL_DAYS,
} from '../config/promos';

// Never hardcode the price here. It has to agree with what Polar actually
// charges, and the same drift that left the changelog link pointing at v0-7-2
// would be a consumer-facing problem rather than a broken href.
const offer = activeOffer(new Date());
const priceCents = offer?.priceCents ?? REGULAR_PRICE_CENTS;
const updateMonths = offer?.updateMonths ?? REGULAR_UPDATE_MONTHS;
// "founding price" while that offer runs, plain "once" when it has ended.
const priceQualifier = offer ? offer.label.toLowerCase() : 'once';


const heroSlides = [
  {
    base: 'capture-area',
    w: 850,
    h: 566,
    alt: 'Area capture in progress: selection rectangle, pixel loupe, and live dimensions readout',
    subtitle: 'Capture with precision',
    description: 'A pixel loupe and live dimensions — select exactly what you mean, down to the pixel.',
  },
  {
    base: 'record-prompt',
    w: 850,
    h: 560,
    alt: 'The Record prompt with system audio, microphone, cursor, and countdown options',
    subtitle: 'Record on your terms',
    description: 'Screen, window, or region — with system audio and mic, and a countdown to set the stage.',
  },
  {
    base: 'editor-overview',
    w: 850,
    h: 548,
    alt: 'The Sealshot editor with a capture open: annotation toolbar, canvas, and Info panel',
    subtitle: 'Annotate without damage',
    description: 'Arrows, labels, and blurs stay editable forever; your original pixels are never touched.',
  },
  {
    base: 'redaction-review',
    w: 850,
    h: 700,
    alt: 'Smart Redaction review panel with detected sensitive items pre-checked',
    subtitle: 'Redact with confidence',
    description: 'Smart Redaction finds emails, cards, and keys on device, and covers them with solid fill before you export.',
  },
  {
    base: 'lock-screen',
    w: 850,
    h: 606,
    alt: 'Sealshot locked: captures encrypted on this Mac, unlocking with Touch ID',
    subtitle: "Locked until it's you",
    description: 'Encrypt everything Sealshot stores and unlock with Touch ID. Capturing still works while locked.',
  },
  {
    base: 'extract-data',
    w: 850,
    h: 464,
    alt: 'Extract Structured Data pulling an invoice table out of a screenshot',
    subtitle: 'Data out of pixels',
    description: 'Pull tables and form fields from any screenshot as clean, copyable text — on your Mac.',
  },
  {
    base: 'library-grid',
    w: 850,
    h: 608,
    alt: 'The Library in grid view with OCR full-text search',
    subtitle: 'Find any capture',
    description: 'Search the text inside your screenshots, organized with collections and favorites.',
  },
];

const trustPoints = [
  'On-device only',
  'No account',
  'No telemetry',
  'Data Encrypted',
];

const pillars = [
  {
    label: 'Private',
    icon: 'ic-shield',
    title: 'On-device Only',
    body: 'Capture, OCR, redaction, AI and data processing all run locally. No account, no telemetry, no cloud.',
  },
  {
    label: 'Secure',
    icon: 'ic-lock',
    title: 'Encryption Available',
    body: 'Enhanced Security encrypts everything on disk, and app auto locks when idle, so data is protected at rest.',
  },
  {
    label: 'Intelligent',
    icon: 'ic-spark',
    title: 'Built-in AI',
    body: 'AI features such as data extraction with context, summary and keyword generation run on your Mac with Apple Intelligence.',
  },
];

const features = [
  {
    title: 'Capture',
    icon: 'ic-frame',
    body: 'Area, window, fullscreen, delayed, and scrolling capture across all your displays.',
  },
  {
    title: 'Record',
    icon: 'ic-record',
    body: 'Record the screen, a window, or a region as video with system audio and mic.',
  },
  {
    title: 'Annotate',
    icon: 'ic-pen',
    body: 'Shapes, arrows, pen, text, numbered badges, crops on their own layer',
  },
  {
    title: 'Redact',
    icon: 'ic-shield-half',
    body: 'Smart Redaction auto finds sensitive information and highlights for redaction',
  },
  {
    title: 'Data Extract',
    icon: 'ic-table',
    body: 'Automatic titles, summaries, keywords, tables and form fields pulled out as copyable text.',
  },
  {
    title: 'Organize',
    icon: 'ic-collection',
    body: 'Collections, favorites, and tags keep a growing library navigable.',
  },
  {
    title: 'Search',
    icon: 'ic-search',
    body: 'OCR full-text search finds a capture by the words inside captured content.',
  },
  {
    title: 'Share',
    icon: 'ic-package',
    body: 'Export any capture as a package with encryption and share.',
  },
];
---

<SiteLayout
  title="Sealshot — privacy-first screenshots and recordings for Mac"
  description="Capture, record, annotate, and redact with everything processed on device. No account, no telemetry, no cloud."
>
  {/*
    Card glyph sprite — defined once, referenced by <use> on each card. Inline
    rather than a sprite file so the icons cost no request, and kept on this page
    rather than in SiteLayout because only the landing page uses them.
  */}
  <svg aria-hidden="true" style="position:absolute;width:0;height:0;overflow:hidden">
    <defs>
      <symbol id="ic-shield" viewBox="0 0 24 24"><path d="M12 3l7 3v5c0 4.4-2.9 7.5-7 9-4.1-1.5-7-4.6-7-9V6l7-3z"/><path d="M9 12l2 2 4-4"/></symbol>
      <symbol id="ic-lock" viewBox="0 0 24 24"><rect x="4" y="10" width="16" height="10" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/><path d="M12 14v2"/></symbol>
      <symbol id="ic-spark" viewBox="0 0 24 24"><path d="M12 3l1.7 4.6L18.3 9.3l-4.6 1.7L12 15.6l-1.7-4.6L5.7 9.3l4.6-1.7L12 3z"/><path d="M18 16.5l.7 1.8 1.8.7-1.8.7-.7 1.8-.7-1.8-1.8-.7 1.8-.7.7-1.8z"/></symbol>
      <symbol id="ic-frame" viewBox="0 0 24 24"><path d="M4 9V5.5A1.5 1.5 0 0 1 5.5 4H9"/><path d="M15 4h3.5A1.5 1.5 0 0 1 20 5.5V9"/><path d="M20 15v3.5a1.5 1.5 0 0 1-1.5 1.5H15"/><path d="M9 20H5.5A1.5 1.5 0 0 1 4 18.5V15"/></symbol>
      <symbol id="ic-record" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="12" rx="2"/><path d="M9 20h6"/><circle cx="12" cy="11" r="2.6"/></symbol>
      <symbol id="ic-pen" viewBox="0 0 24 24"><path d="M4.5 19.5l4.2-1.1 9.1-9.1-3.1-3.1-9.1 9.1-1.1 4.2z"/><path d="M14.7 6.2l3.1 3.1"/><path d="M8.7 18.4l-3.1-3.1"/></symbol>
      <symbol id="ic-shield-half" viewBox="0 0 24 24"><path d="M12 3L5 6v5c0 4.4 2.9 7.5 7 9z" fill="currentColor" stroke="none"/><path d="M12 3l7 3v5c0 4.4-2.9 7.5-7 9-4.1-1.5-7-4.6-7-9V6l7-3z"/></symbol>
      <symbol id="ic-table" viewBox="0 0 24 24"><rect x="3.5" y="4.5" width="17" height="15" rx="2"/><path d="M3.5 10h17"/><path d="M9.5 10v9.5"/></symbol>
      <symbol id="ic-collection" viewBox="0 0 24 24"><rect x="4" y="4" width="7" height="7" rx="1.6"/><rect x="13" y="4" width="7" height="7" rx="1.6"/><rect x="4" y="13" width="7" height="7" rx="1.6"/><rect x="13" y="13" width="7" height="7" rx="1.6"/></symbol>
      <symbol id="ic-package" viewBox="0 0 24 24"><path d="M12 3l8 4.5v9L12 21l-8-4.5v-9L12 3z"/><path d="M4 7.5l8 4.5 8-4.5"/><path d="M12 12v9"/></symbol>
      <symbol id="ic-search" viewBox="0 0 24 24"><circle cx="10.5" cy="10.5" r="5.8"/><path d="M14.8 14.8L20 20"/></symbol>
      <symbol id="ic-bug" viewBox="0 0 24 24"><rect x="7.5" y="8.5" width="9" height="11" rx="4.5"/><path d="M9.5 8.5l-1-2M14.5 8.5l1-2"/><path d="M4.5 12.5h3M16.5 12.5h3M5 18l2.5-1.6M19 18l-2.5-1.6"/></symbol>
      <symbol id="ic-doclock" viewBox="0 0 24 24"><path d="M13.5 3.5H7a1.5 1.5 0 0 0-1.5 1.5v14A1.5 1.5 0 0 0 7 20.5h3"/><path d="M13.5 3.5L18 8v3"/><rect x="13" y="14.5" width="6.5" height="5.5" rx="1.2"/><path d="M14.8 14.5v-1.4a1.5 1.5 0 0 1 3 0v1.4"/></symbol>
      <symbol id="ic-play" viewBox="0 0 24 24"><rect x="3" y="4.5" width="18" height="12" rx="2"/><path d="M9 20h6"/><path d="M10.5 8.2l4.6 2.3-4.6 2.3V8.2z"/></symbol>
    </defs>
  </svg>
  <section class="hero">
    <div class="wrap">
      <p class="kicker">For macOS 14+</p>
      <h1>Smart Screenshots, Enhanced Security and <span class="nobreak">On-Device Only</span></h1>
      <p class="sub">
        Capture, record, annotate, redact, and extract data from any
        screenshot. No account. No telemetry. No cloud.
      </p>
      <div class="actions">
        <a class="button" href="/download/">Download for Mac</a>
        <a class="button secondary" href="/docs/">Read the docs</a>
      </div>
      <p class="buy-signal">
        Free for {TRIAL_DAYS} days · <strong>{formatUSDCompact(priceCents)} {priceQualifier}</strong>,
        no subscription · {updateMonths} months of updates ·
        <a href="/buy/">What you get</a>
      </p>
      <ul class="trust-strip" aria-label="Privacy guarantees">
        {trustPoints.map((point) => <li>{point}</li>)}
      </ul>
      <section class="hero-carousel splide" aria-label="Sealshot app screenshots">
        <div class="splide__track">
          <ul class="splide__list">
            {
              heroSlides.map((slide, i) => (
                <li class="splide__slide">
                  <figure class="hero-slide">
                    <div class="hero-slide-media">
                      <img
                        src={`/manual/hero/${slide.base}-850.jpg`}
                        srcset={`/manual/hero/${slide.base}-400.jpg 400w, /manual/hero/${slide.base}-850.jpg 850w, /manual/hero/${slide.base}-1400.jpg 1400w`}
                        sizes="(max-width: 640px) 80vw, 850px"
                        width={slide.w}
                        height={slide.h}
                        alt={slide.alt}
                        loading={i === 0 ? 'eager' : 'lazy'}
                        decoding={i === 0 ? 'sync' : 'async'}
                        fetchpriority={i === 0 ? 'high' : undefined}
                      />
                    </div>
                    <figcaption>
                      <strong>{slide.subtitle}</strong>
                      <span>{slide.description}</span>
                    </figcaption>
                  </figure>
                </li>
              ))
            }
          </ul>
        </div>
      </section>
    </div>
  </section>

  <section class="section alt" aria-labelledby="pillars-heading">
    <div class="wrap">
      <p class="kicker">Why Sealshot</p>
      <h2 id="pillars-heading">Private, secure, and smart — by design</h2>
      <div class="features pillars">
        {
          pillars.map((p) => (
            <div class="feature pillar">
              <svg class="card-icon" aria-hidden="true"><use href={`#${p.icon}`} /></svg>
              <p class="pillar-label">{p.label}</p>
              <h3>{p.title}</h3>
              <p>{p.body}</p>
            </div>
          ))
        }
      </div>
      <p class="pillars-note">
        Three downloads, ever: app updates, a public list of revoked licenses,
        and an optional redaction model you approve first. Your captures are
        never one of them, and nothing is ever uploaded.
      </p>
    </div>
  </section>

  <section class="section" id="features" aria-labelledby="features-heading">
    <div class="wrap">
      <p class="kicker">Features</p>
      <h2 id="features-heading">Everything a capture tool should do and beyond</h2>
      <div class="features">
        {
          features.map((f) => (
            <div class="feature">
              <svg class="card-icon" aria-hidden="true"><use href={`#${f.icon}`} /></svg>
              <h3>{f.title}</h3>
              <p>{f.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="workflows-heading">
    <div class="wrap">
      <p class="kicker">Workflows</p>
      <h2 id="workflows-heading">Built for the job in front of you</h2>
      <div class="features workflows">
        <a class="feature workflow-card" href="/docs/workflows/explain/">
          <svg class="card-icon" aria-hidden="true"><use href="#ic-bug" /></svg>
          <h3>Report bugs without leaking your stack</h3>
          <p>
            Capture the repro, number the steps, and let Smart Redaction
            catch the keys and tokens before the ticket does.
          </p>
          <span class="workflow-link">See the workflow →</span>
        </a>
        <a class="feature workflow-card" href="/docs/workflows/protect-and-share/">
          <svg class="card-icon" aria-hidden="true"><use href="#ic-doclock" /></svg>
          <h3>Share sensitive documents safely</h3>
          <p>
            Document-aware redaction, encryption at rest, and an encrypted
            package with an expiry — passcode over a separate channel.
          </p>
          <span class="workflow-link">See the workflow →</span>
        </a>
        <a class="feature workflow-card" href="/docs/workflows/demonstrate/">
          <svg class="card-icon" aria-hidden="true"><use href="#ic-play" /></svg>
          <h3>Record a walkthrough people can follow</h3>
          <p>
            Narrated screen recording with clean voice audio and keyboard
            pauses — exported as an .mp4 anyone can play.
          </p>
          <span class="workflow-link">See the workflow →</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section alt" aria-labelledby="updates-heading">
    <div class="wrap">
      <p class="kicker">Stay in the loop</p>
      <h2 id="updates-heading">Get Sealshot updates</h2>
      <p class="sub">
        Product news, new releases, occasional offers, and tips for getting more
        out of Sealshot.
      </p>
      <NewsletterForm />
    </div>
  </section>
</SiteLayout>

<script>
  import Splide from '@splidejs/splide';

  new Splide('.hero-carousel', {
    // Not 'loop': it clones every slide, and the clones sit close enough to the
    // viewport that loading="lazy" never defers anything — all seven images
    // downloaded on first paint. 'slide' + rewind cycles the same way.
    type: 'slide',
    rewind: true,
    autoplay: true,
    interval: 6000,
    pauseOnHover: true,
    pauseOnFocus: true,
    speed: 500,
    reducedMotion: { speed: 0, rewindSpeed: 0, autoplay: 'pause' },
  }).mount();
</script>
