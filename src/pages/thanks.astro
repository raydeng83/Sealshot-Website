---
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout
  title="Thank you — Sealshot"
  description="Thank you for supporting Sealshot."
  noindex
  hideBar
>
  <section class="section wrap" aria-labelledby="thanks-title">
    <p class="kicker">Thank you</p>
    <h1 id="thanks-title">That's it. Thank you.</h1>
    <p class="sub">
      Your donation is what keeps Sealshot being built. Polar will email you a
      receipt; there is nothing else to wait for and nothing to activate.
    </p>

    <div class="thanks-card">
      <h2>One last thing</h2>
      <p>
        Open Sealshot, go to <strong>Settings ▸ Support</strong>, and tick
        <strong>"I've donated"</strong> — the occasional reminder stops for
        good. It's on the honor system, so that checkbox is the whole ceremony.
      </p>
    </div>

    <p>
      <a class="button secondary" href="/docs/quickstart/install/">Read the quickstart</a>
    </p>
  </section>
</SiteLayout>

<style>
  .thanks-card {
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius);
    box-shadow: var(--shadow-card);
    padding: 1.5rem;
    margin: 1.5rem 0;
    background: var(--surface-band);
  }
  .thanks-card.quiet { background: var(--surface-page); }
  .thanks-card h2 { margin: 0 0 0.5rem; font-size: 1.125rem; }
  .thanks-card ol { margin: 0 0 0.75rem; padding-left: 1.25rem; }
  .thanks-card li { margin-bottom: 0.4rem; }
  .muted { color: var(--slate-600); margin-bottom: 0; }
</style>
