---
import SiteLayout from '../layouts/SiteLayout.astro';

/*
  Feature comparison. Every competitor cell is what that vendor's own page said
  on the date below — not a judgment, and not taken from third-party "best
  screenshot app" round-ups, most of which are published by other screenshot
  apps.

  Two rules for editing this file:

  1. A silent page is "not stated", never a cross. Absence from marketing copy is
     not evidence a feature is missing, and a wrong cross here would cost more
     than this page earns.
  2. If you change a cell, change COMPARED_ON too.
*/

const COMPARED_ON = '15 August 2026';

// Sealshot last: the reader crosses the field before arriving at us, and a table
// that opens with our own column reads as a brochure.
const APPS = [
  { key: 'cleanshot', name: 'CleanShot X', source: 'https://cleanshot.com/' },
  { key: 'snagit', name: 'Snagit', source: 'https://www.techsmith.com/screen-capture.html' },
  { key: 'shottr', name: 'Shottr', source: 'https://shottr.cc/' },
  { key: 'xnapper', name: 'Xnapper', source: 'https://xnapper.com/' },
  { key: 'sealshot', name: 'Sealshot', source: '/docs/', ours: true },
];

const ROWS = [
  {
    label: 'Price',
    cleanshot: '$29 once',
    snagit: '$39 per user, per year',
    shottr: 'Free · $12 · $30',
    xnapper: 'Free with watermark; one-time to remove',
    sealshot: '$39 once',
  },
  {
    label: 'License model',
    cleanshot: 'One-time, 1 year of updates, $19/yr optional',
    snagit: 'Subscription only',
    shottr: 'One-time',
    xnapper: 'One-time',
    sealshot: 'One-time, 18 months of updates, $24 optional',
  },
  {
    label: 'Macs per license',
    cleanshot: 'Multiple',
    snagit: 'Not stated',
    shottr: '1 user, up to 5 computers',
    xnapper: 'Not stated',
    sealshot: '2',
  },
  {
    label: 'Capture modes',
    cleanshot: 'Area, window, fullscreen, self-timer',
    snagit: 'Region, window, fullscreen',
    shottr: 'Area, window, fullscreen, 3s delay',
    xnapper: 'Window, screenshot',
    sealshot: 'Area, window, fullscreen, delayed',
  },
  {
    label: 'Scrolling capture',
    cleanshot: 'Yes',
    snagit: 'Yes',
    shottr: 'Yes',
    xnapper: 'Not mentioned',
    sealshot: 'Yes, with automatic stitching',
  },
  {
    label: 'Screen recording',
    cleanshot: 'Yes — mic, system audio, webcam',
    snagit: 'Yes — webcam, GIF',
    shottr: 'Not mentioned',
    xnapper: 'Not mentioned',
    sealshot: 'Yes — mic, system audio',
  },
  {
    label: 'Finds sensitive data for you',
    cleanshot: 'No — manual blur',
    snagit: 'Yes',
    shottr: 'No — manual',
    xnapper: 'Yes — emails, cards, IPs, API keys',
    sealshot: 'Yes — emails, cards, IDs, API keys',
    note: true,
  },
  {
    label: 'What redaction leaves behind',
    cleanshot: 'Blur or pixelate',
    snagit: '“Automatically blur”',
    shottr: 'Pixelate or blur',
    xnapper: '“Hide” — method not stated',
    sealshot: 'Unrecoverable fill',
    note: true,
  },
  {
    label: 'Text recognition (OCR)',
    cleanshot: 'Yes, on device',
    snagit: 'Yes',
    shottr: 'Yes, plus QR',
    xnapper: 'Yes, on device',
    sealshot: 'Yes, on device',
  },
  {
    label: 'Extracts tables and form fields',
    cleanshot: 'Not mentioned',
    snagit: 'Not mentioned',
    shottr: 'Not mentioned',
    xnapper: 'Not mentioned',
    sealshot: 'Yes',
  },
  {
    label: 'Capture library',
    cleanshot: 'Yes — 1 month of history',
    snagit: 'Yes — searchable, taggable',
    shottr: 'Not mentioned',
    xnapper: 'Yes — screenshot history',
    sealshot: 'Yes — collections, tags, OCR search',
  },
  {
    label: 'Encryption at rest',
    cleanshot: 'Not stated',
    snagit: 'Not stated',
    shottr: 'Not stated',
    xnapper: 'Not stated',
    sealshot: 'Yes — AES-256-GCM behind Touch ID, opt-in',
    note: true,
  },
  {
    label: 'Cloud upload',
    cleanshot: 'Optional — CleanShot Cloud',
    snagit: 'YouTube, Drive, Dropbox',
    shottr: 'Your own S3 bucket',
    xnapper: '“Coming soon”',
    sealshot: 'None',
  },
  {
    label: 'Account required',
    cleanshot: 'No — “not required to use the app”',
    snagit: 'Not stated',
    shottr: 'Not stated',
    xnapper: 'Not stated',
    sealshot: 'No — activation works offline',
  },
  {
    label: 'Platforms',
    cleanshot: 'macOS 10.15+',
    snagit: 'Windows and Mac',
    shottr: 'macOS 10.15+',
    xnapper: 'Mac',
    sealshot: 'macOS 14+',
  },
];

// Cards on narrow screens put us first — nobody swipes to a fifth column.
const CARD_ORDER = [APPS[4], APPS[0], APPS[1], APPS[2], APPS[3]];

const ELSEWHERE = [
  ['You need Windows', 'Snagit is the only one here that runs on it.'],
  ['You want it free', 'Shottr and Xnapper both have real free tiers. Sealshot has a 14-day trial and then costs money.'],
  ['You want a share link', 'CleanShot Cloud, or a team tool like Zight, Droplr, or Monosnap. Sealshot deliberately hosts nothing, so there is no URL to send.'],
  ['Presentation screenshots are the job', 'Xnapper exists for exactly that — balanced padding, backgrounds, ready to drop in a deck.'],
  ['You manage seats for a team', 'Snagit’s business plans, or the team tools above. Sealshot has no per-seat administration.'],
];

const CHECKS = [
  ['Watch the network', 'Point Little Snitch, Proxyman, or tcpdump at any of these for an hour of real work. Capture, edit, search, export, and use every AI feature. What it contacts, and when, is a fact rather than a claim.'],
  ['Attack your own redaction', 'Redact something, export it, then try to get it back: zoom, push levels and contrast, run OCR over it, open it in another editor. Test the layered package as well as the flat image — they can behave differently.'],
  ['Pull the plug', 'Install on a machine with no network and try to work. Then try activating a paid license offline.'],
  ['Read the privacy policy for specifics', 'Look for one that names each network request rather than describing a posture. Vague is not the same as harmless.'],
];
---

<SiteLayout
  title="Sealshot compared — Mac screenshot apps, feature by feature"
  description="How Sealshot compares with CleanShot X, Snagit, Shottr, and Xnapper on capture, redaction, encryption, cloud, and price — taken from each vendor's own documentation, with sources."
>
  <section class="section wrap" aria-labelledby="cmp-title">
    <p class="kicker">Comparison</p>
    <h1 id="cmp-title">Sealshot compared</h1>
    <p class="sub">
      Five Mac screenshot tools, feature by feature. Every cell about another app
      is what that vendor's own page said on {COMPARED_ON} — not our reading of
      it, and not lifted from a round-up. Where a page says nothing, this table
      says “not stated” rather than guessing, because silence is not evidence.
    </p>

    <div class="cmp-scroll">
      <table class="cmp">
        <caption class="visually-hidden">
          Feature comparison of CleanShot X, Snagit, Shottr, Xnapper, and Sealshot
        </caption>
        <thead>
          <tr>
            <th scope="col">Feature</th>
            {APPS.map((a) => (
              <th scope="col" class={a.ours ? 'is-ours' : undefined}>{a.name}</th>
            ))}
          </tr>
        </thead>
        <tbody>
          {ROWS.map((r) => (
            <tr>
              <th scope="row">{r.label}</th>
              {APPS.map((a) => (
                <td class={[a.ours ? 'is-ours' : '', r.note && a.ours ? 'is-key' : '']
                  .filter(Boolean).join(' ') || undefined}>{r[a.key]}</td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="cmp-cards">
      {CARD_ORDER.map((a) => (
        <article class={a.ours ? 'cmp-card is-ours' : 'cmp-card'}>
          <h2>{a.name}</h2>
          <dl>
            {ROWS.map((r) => (
              <>
                <dt>{r.label}</dt>
                <dd>{r[a.key]}</dd>
              </>
            ))}
          </dl>
        </article>
      ))}
    </div>

    <p class="cmp-sources">
      Compared {COMPARED_ON}, from each vendor's own pages:
      {APPS.filter((a) => !a.ours).map((a, i) => (
        <>{i > 0 ? ' · ' : ' '}<a href={a.source} rel="nofollow noopener">{a.name}</a></>
      ))}. Prices are the publicly listed individual ones and exclude tax.
      Something out of date or wrong? <a href="/support/">Tell us</a> — we would
      rather fix it than defend it.
    </p>

    <h2 id="elsewhere">When one of the others is the better buy</h2>
    <p>
      A comparison with nothing but wins in our own column would not be worth
      reading. These are the cases where we would point you elsewhere:
    </p>
    <dl class="cmp-else">
      {ELSEWHERE.map(([when, what]) => (
        <>
          <dt>{when}</dt>
          <dd>{what}</dd>
        </>
      ))}
    </dl>

    <h2 id="checks">How to check any of this yourself</h2>
    <p>
      Every tool in this category says it respects your privacy. These are the
      tests that turn that into something you can see — and they work on us as
      well as on them.
    </p>
    <dl class="cmp-else">
      {CHECKS.map(([title, how]) => (
        <>
          <dt>{title}</dt>
          <dd>{how}</dd>
        </>
      ))}
    </dl>

    <p class="cmp-foot">
      Not compared here: the screenshot tool built into macOS, which is free and
      on every Mac — if ⌘⇧5 already does what you need, use it. Nor the
      link-first team tools (Zight, Droplr, Monosnap), which solve sharing rather
      than capture.
    </p>
  </section>
</SiteLayout>

<style>
  .cmp-scroll { overflow-x: auto; margin: 2rem 0 1rem; }

  .cmp {
    border-collapse: collapse;
    width: 100%;
    min-width: 54rem;
    font-size: 0.9rem;
  }

  .cmp th,
  .cmp td {
    text-align: left;
    vertical-align: top;
    padding: 0.6rem 0.7rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .cmp thead th {
    border-bottom: 2px solid var(--navy-900);
    font-size: 0.95rem;
  }

  .cmp tbody th {
    font-weight: 600;
    color: var(--navy-900);
    width: 12rem;
  }

  .cmp td { color: var(--slate-600); }

  /* Our column is tinted rather than ticked — the point is that a reader can see
     where it differs, not that it looks like a winner's podium. */
  .cmp .is-ours { background: var(--surface-band); color: var(--navy-900); }
  .cmp thead .is-ours { color: var(--orange-700); }
  .cmp .is-key { font-weight: 600; }

  .cmp-cards { display: none; }

  .cmp-sources,
  .cmp-foot { color: var(--slate-600); font-size: 0.9rem; max-width: 46rem; }
  .cmp-sources { margin-bottom: 2.5rem; }

  .section h2 { font-size: 1.3rem; margin: 2rem 0 0.5rem; }

  .cmp-else { max-width: 46rem; margin: 1rem 0 0; }
  .cmp-else dt { font-weight: 600; margin-top: 0.9rem; }
  .cmp-else dd { margin: 0.2rem 0 0; color: var(--slate-600); }

  /* Below this the table needs six columns in about 350px, which no amount of
     scrolling makes readable. One card per app instead, ours first — nobody
     swipes sideways to reach a fifth column. */
  @media (max-width: 60rem) {
    .cmp-scroll { display: none; }
    .cmp-cards { display: grid; gap: 1rem; margin: 2rem 0 1rem; }

    .cmp-card {
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius);
      box-shadow: var(--shadow-card);
      padding: 1.25rem;
    }

    .cmp-card.is-ours { background: var(--surface-band); border-color: var(--orange-600); }
    .cmp-card h2 { font-size: 1.15rem; margin: 0 0 0.75rem; }
    .cmp-card.is-ours h2 { color: var(--orange-700); }
    .cmp-card dl { margin: 0; display: grid; grid-template-columns: 1fr; gap: 0.1rem; }
    .cmp-card dt { font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.06em;
      color: var(--slate-400); margin-top: 0.7rem; }
    .cmp-card dd { margin: 0; font-size: 0.95rem; }
  }
</style>
