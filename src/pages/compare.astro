---
import SiteLayout from '../layouts/SiteLayout.astro';
import comparison from '../data/comparison.json';

/*
  The table's data lives in src/data/comparison.json — edit it there, or edit the
  Excel export and run output/import-comparison-xlsx.py. The rules for what may go
  in a cell are in that file's _comment.

  This page holds only presentation. The footnotes, sources list, "when one of the
  others is the better buy" and "how to check this yourself" sections are parked —
  removed from the page, still in git and (for the footnotes) still in the JSON, so
  they can come back without being rewritten.
*/

const { checkedOn: CHECKED_ON, apps: APPS, groups: GROUPS, highlight: HIGHLIGHT } =
  comparison;

// Only show legend entries the table actually uses. Two of the three described
// nothing after the spreadsheet import, and a legend defining absent terms is
// worse than none. Self-maintaining: a term reappearing brings its row back.
const USED = new Set(
  GROUPS.flatMap((g) => g.rows).flatMap((r) =>
    APPS.map((a) => (typeof r[a.key] === 'string' ? r[a.key].trim() : ''))),
);
const LEGEND = comparison.legend.filter(([term]) => USED.has(term));

const isHighlight = (label: string, key: string) =>
  HIGHLIGHT && label === HIGHLIGHT.label && key === HIGHLIGHT.app;

const CARD_ORDER = [APPS[4], APPS[0], APPS[1], APPS[2], APPS[3]];


---

<SiteLayout
  title="Sealshot compared — Mac screenshot apps, feature by feature"
  description="How Sealshot compares with CleanShot X, Snagit, Shottr, and Xnapper on capture, redaction, encryption, sharing, and price — from each vendor's own documentation, with sources and a checked-on date."
>
  <section class="section wrap" aria-labelledby="cmp-title">
    <p class="kicker">Comparison</p>
    <h1 id="cmp-title">Sealshot compared</h1>
    <p class="sub">
      Five Mac screenshot tools, feature by feature, from each vendor's own
      documentation rather than from a round-up. Where a vendor's pages are
      silent or disagree, this table says so instead of guessing.
    </p>

    <p class="cmp-checked">Information checked {CHECKED_ON}.</p>

    <dl class="cmp-legend">
      {LEGEND.map(([term, meaning]) => (
        <>
          <dt>{term}</dt>
          <dd>{meaning}</dd>
        </>
      ))}
    </dl>

    <div class="cmp-scroll">
      <table class="cmp">
        <caption class="visually-hidden">
          Feature comparison of CleanShot X, Snagit, Shottr, Xnapper, and Sealshot
        </caption>
        <thead>
          <tr>
            <th scope="col">Feature</th>
            {APPS.map((a) => (
              <th scope="col" class={a.ours ? 'is-ours' : undefined}>{a.name}</th>
            ))}
          </tr>
        </thead>
        {GROUPS.map((g) => (
          <tbody>
            <tr class="cmp-group">
              <th scope="colgroup" colspan={APPS.length + 1}>{g.title}</th>
            </tr>
            {g.rows.map((r) => (
              <tr>
                <th scope="row">{r.label}</th>
                {APPS.map((a) => (
                  <td class={[a.ours ? 'is-ours' : '',
                              isHighlight(r.label, a.key) ? 'is-highlight' : '']
                    .filter(Boolean).join(' ') || undefined}>{r[a.key]}</td>
                ))}
              </tr>
            ))}
          </tbody>
        ))}
      </table>
    </div>

    <div class="cmp-cards">
      {CARD_ORDER.map((a) => (
        <article class={a.ours ? 'cmp-card is-ours' : 'cmp-card'}>
          <h2>{a.name}</h2>
          {GROUPS.map((g) => (
            <>
              <p class="cmp-card-group">{g.title}</p>
              <dl>
                {g.rows.map((r) => (
                  <>
                    <dt>{r.label}</dt>
                    <dd class={isHighlight(r.label, a.key) ? 'is-highlight' : undefined}>
                      {r[a.key]}
                    </dd>
                  </>
                ))}
              </dl>
            </>
          ))}
        </article>
      ))}
    </div>

  </section>
</SiteLayout>

<style>
  .cmp-checked { font-size: 0.85rem; color: var(--slate-600); margin: 0.75rem 0 1.25rem; }

  .cmp-legend {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.2rem 0.9rem;
    max-width: 40rem;
    margin: 0 0 1.75rem;
    font-size: 0.85rem;
    padding: 0.9rem 1rem;
    background: var(--surface-footer);
    border-radius: var(--radius);
  }

  .cmp-legend dt { font-weight: 600; white-space: nowrap; }
  .cmp-legend dd { margin: 0; color: var(--slate-600); }

  .cmp-scroll { overflow-x: auto; margin: 0 0 1rem; }
  .cmp { border-collapse: collapse; width: 100%; min-width: 58rem; font-size: 0.88rem; }

  .cmp th,
  .cmp td {
    text-align: left;
    vertical-align: top;
    padding: 0.55rem 0.7rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .cmp thead th { border-bottom: 2px solid var(--navy-900); font-size: 0.95rem; }
  .cmp tbody th { font-weight: 600; color: var(--navy-900); width: 14rem; }
  .cmp td { color: var(--slate-600); }

  /* Air above each category so the sections read as groups rather than one long
     list. Tables cannot take margin between rows, so it is padding on the cell —
     asymmetric, since the space belongs above the label, not below it. */
  .cmp-group th {
    background: var(--surface-tint);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--navy-900);
    width: auto;
    padding-top: 1.4rem;
    padding-bottom: 0.45rem;
  }

  /* The first category sits directly under the header rule and needs less. */
  .cmp tbody:first-of-type .cmp-group th { padding-top: 0.6rem; }

  /* Our column is tinted and nothing else. Emphasis applied only to our own
     favourable cells makes the whole table read as advocacy. */
  .cmp .is-ours { background: var(--surface-band); color: var(--navy-900); }
  .cmp thead .is-ours { color: var(--orange-700); }

  /* The one cell allowed to shout. Everywhere else the tint does the work — but
     price is the argument this table is making, so it gets weight, the accent, and
     a rule down its left edge to catch the eye scanning the bottom row. */
  .cmp td.is-highlight {
    background: var(--mint-50);
    color: var(--navy-900);
    font-weight: 700;
    font-size: 0.95rem;
    border-left: 3px solid var(--orange-600);
  }

  .cmp-cards { display: none; }

  .cmp-notes {
    max-width: 46rem;
    margin: 0 0 2rem;
    padding-left: 1.2rem;
    font-size: 0.85rem;
    color: var(--slate-600);
  }

  .cmp-notes li { margin-bottom: 0.5rem; }
  .cmp-notes li:target { background: var(--mint-50); }

  .section h2 { font-size: 1.3rem; margin: 2rem 0 0.5rem; }

  .cmp-sources {
    max-width: 46rem;
    margin: 0.5rem 0 0.75rem;
    padding-left: 1.2rem;
    font-size: 0.9rem;
    color: var(--slate-600);
  }

  .cmp-sources li { margin-bottom: 0.3rem; }
  .cmp-note-foot { color: var(--slate-600); font-size: 0.9rem; max-width: 46rem; }
  .cmp-else { max-width: 46rem; margin: 1rem 0 0; }
  .cmp-else dt { font-weight: 600; margin-top: 0.9rem; }
  .cmp-else dd { margin: 0.2rem 0 0; color: var(--slate-600); }

  /* Six columns in 350px is unreadable however far it scrolls. One card per app
     instead, ours first, since nobody swipes sideways to reach a fifth column. */
  @media (max-width: 60rem) {
    .cmp-scroll { display: none; }
    .cmp-cards { display: grid; gap: 1rem; margin: 0 0 1.5rem; }

    .cmp-card {
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius);
      box-shadow: var(--shadow-card);
      padding: 1.25rem;
    }

    .cmp-card.is-ours { background: var(--surface-band); border-color: var(--orange-600); }
    .cmp-card h2 { font-size: 1.15rem; margin: 0 0 0.5rem; }
    .cmp-card.is-ours h2 { color: var(--orange-700); }

    .cmp-card-group {
      font-size: 0.7rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--orange-700);
      margin: 1rem 0 0.25rem;
      border-top: 1px solid var(--border-subtle);
      padding-top: 0.6rem;
    }

    .cmp-card dl { margin: 0; }
    .cmp-card dt { font-size: 0.8rem; color: var(--slate-400); margin-top: 0.55rem; }
    .cmp-card dd { margin: 0; font-size: 0.95rem; }

    .cmp-card dd.is-highlight {
      font-weight: 700;
      color: var(--orange-700);
      background: var(--mint-50);
      border-left: 3px solid var(--orange-600);
      padding: 0.35rem 0.5rem;
      margin: 0.15rem 0 0;
      border-radius: 0 4px 4px 0;
    }
  }
</style>
