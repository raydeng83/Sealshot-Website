---
import SiteLayout from '../layouts/SiteLayout.astro';

/*
  Feature comparison.

  Rules for editing, all learned the hard way:

  1. Every competitor cell is what that vendor's own documentation says. Not
     third-party round-ups — most "best screenshot app" lists are published by
     rival screenshot apps, and they contradict each other.
  2. Use the LEGEND vocabulary. "Not documented" is not "No". A wrong "No" here
     costs more than this page earns.
  3. Wording must be symmetrical. If we say "auto-scroll and stitch" of
     ourselves, every competitor that also auto-stitches gets the same phrase —
     an asymmetry reads as a thumb on the scale even when each cell is true.
  4. Our column gets a tint and nothing else. No bolding of favourable cells.
  5. Change a cell, change CHECKED_ON.
*/

const CHECKED_ON = 'August 15, 2026';

const LEGEND = [
  ['No', 'Explicitly unsupported, or tested absent.'],
  ['Not documented', 'Not found in the vendor’s official documentation.'],
  ['Unverified', 'Official sources conflict; needs hands-on confirmation.'],
];

// Sealshot last: the reader crosses the field before arriving at us.
const APPS = [
  {
    key: 'cleanshot',
    name: 'CleanShot X',
    sources: [
      ['pricing', 'https://cleanshot.com/pricing'],
      ['device tiers', 'https://cleanshot.com/buy'],
      ['features', 'https://cleanshot.com/features'],
    ],
  },
  {
    key: 'snagit',
    name: 'Snagit',
    sources: [
      ['features', 'https://www.techsmith.com/snagit/features/'],
      ['Smart Redact', 'https://www.techsmith.com/snagit/features/smart-redact/'],
      ['store', 'https://www.techsmith.com/store/snagit/'],
      ['subscription policy', 'https://support.techsmith.com/hc/en-us/articles/27009223314701-TechSmith-Transition-to-Annual-Subscription-Pricing-Model-in-2025'],
    ],
  },
  {
    key: 'shottr',
    name: 'Shottr',
    sources: [
      ['purchase', 'https://shottr.cc/purchase.html'],
      ['scrolling capture', 'https://shottr.cc/kb/scrollingcapture'],
      ['upload', 'https://shottr.cc/kb/upload/'],
      ['start guide', 'https://shottr.cc/kb/startguide'],
    ],
  },
  {
    key: 'xnapper',
    name: 'Xnapper',
    sources: [
      ['pricing', 'https://xnapper.com/pricing'],
      ['changelog', 'https://xnapper.com/changelog'],
    ],
  },
  { key: 'sealshot', name: 'Sealshot', ours: true, sources: [['docs', '/docs/']] },
];

const GROUPS = [
  {
    title: 'Pricing',
    rows: [
      {
        label: 'Price',
        cleanshot: '$29 / 1 Mac · $49 / 2 · $119 / 5',
        snagit: '$39 per user, per year',
        shottr: 'Free · $12 · $30',
        xnapper: 'Free with watermark · $29.99 / 1 device · $54.99 / 2 · $79.99 / 3',
        sealshot: '$39 founding · $49 regular',
      },
      {
        label: 'License model',
        cleanshot: 'One-time; 1 year of updates; 1 GB CleanShot Cloud included',
        snagit: 'Annual subscription only',
        shottr: 'One-time',
        xnapper: 'One-time, perpetual use; 1 year of updates; renewal at 40% off',
        sealshot: 'One-time, perpetual use; 18 months of updates at the founding price; $24 renewal',
      },
      {
        label: 'Devices per individual license tier',
        cleanshot: '1, 2, or 5 by tier',
        snagit: 'Unlimited installs; one active device at a time',
        snagitNote: 2,
        shottr: '1 user, up to 5 computers',
        xnapper: '1, 2, or 3 by tier',
        sealshot: '2',
      },
    ],
  },
  {
    title: 'Capture',
    rows: [
      {
        label: 'Capture modes',
        cleanshot: 'Area, window, fullscreen, self-timer',
        snagit: 'Region, window, fullscreen',
        shottr: 'Area, window, fullscreen, 3-second delay',
        xnapper: 'Window, region, fullscreen',
        sealshot: 'Area, window, fullscreen, delayed',
      },
      {
        label: 'Scrolling capture',
        cleanshot: 'Yes — auto-scroll and stitch',
        snagit: 'Yes — auto-scroll and stitch',
        shottr: 'Yes — auto-scroll and stitch',
        xnapper: 'Yes — full-page',
        sealshot: 'Yes — auto-scroll and stitch',
      },
      {
        label: 'Screen recording',
        cleanshot: 'Yes — microphone, system audio, webcam',
        snagit: 'Yes — microphone, system audio, webcam, GIF',
        shottr: 'Not documented',
        xnapper: 'Yes — fullscreen, region, or window; built-in video editor',
        sealshot: 'Yes — microphone, system audio',
      },
      {
        label: 'Text recognition (OCR)',
        cleanshot: 'Yes, on device',
        snagit: 'Yes',
        shottr: 'Yes, plus QR codes',
        xnapper: 'Yes, on device',
        sealshot: 'Yes, on device',
      },
      {
        label: 'Extracts tables and form fields',
        cleanshot: 'Not documented',
        snagit: 'Not documented',
        shottr: 'Not documented',
        xnapper: 'Not documented',
        sealshot: 'Yes',
      },
    ],
  },
  {
    title: 'Privacy',
    rows: [
      {
        label: 'Automatic sensitive-data detection',
        cleanshot: 'No — manual tools only',
        snagit: 'Yes — addresses, cards, dates, emails, faces, IPs, phones, SSNs, URLs',
        shottr: 'No — manual tools only',
        xnapper: 'Yes — emails, cards, IPs, API keys',
        sealshot: 'Yes — emails, cards, IDs, API keys',
      },
      {
        label: 'Automatic redaction method in flattened exports',
        cleanshot: 'No automatic mode — manual pixelate, secure or smooth blur, filled rectangle',
        snagit: 'Blur, pixelation, or solid bars',
        shottr: 'No automatic mode — manual blur, pixelation, object removal',
        xnapper: 'Not documented',
        sealshot: 'Opaque solid fill; flattened into exported images',
        sealshotNote: 1,
      },
      {
        label: 'App-managed local-library encryption',
        cleanshot: 'Not documented',
        snagit: 'Not documented',
        shottr: 'Not documented',
        xnapper: 'Not documented',
        sealshot: 'Optional app-managed AES-256-GCM; unlock with Touch ID, Apple Watch, or system password',
      },
      {
        label: 'Account required',
        cleanshot: 'No — cloud account “not required to use the app”',
        snagit: 'Yes — TechSmith sign-in required to unlock',
        snagitNote: 2,
        shottr: 'Not documented',
        xnapper: 'Not documented',
        sealshot: 'No — activation works offline',
      },
    ],
  },
  {
    title: 'Organization and sharing',
    rows: [
      {
        label: 'Capture library',
        cleanshot: 'Yes — 1 month of history',
        snagit: 'Yes — searchable, taggable',
        shottr: 'Not documented',
        xnapper: 'Yes — screenshot history',
        sealshot: 'Yes — collections, tags, OCR full-text search',
      },
      {
        label: 'Hosted sharing',
        cleanshot: 'Optional — CleanShot Cloud',
        snagit: 'YouTube, Google Drive, Dropbox',
        shottr: 'Shottr Cloud or your own S3 bucket',
        shottrNote: 3,
        xnapper: 'Unverified',
        xnapperNote: 4,
        sealshot: 'None — packages you send yourself',
      },
    ],
  },
  {
    title: 'Compatibility',
    rows: [
      {
        label: 'Platforms',
        cleanshot: 'macOS 10.15+',
        snagit: 'Windows and Mac',
        shottr: 'macOS 10.15+',
        xnapper: 'Mac',
        sealshot: 'macOS 14+',
      },
    ],
  },
];

const NOTES = [
  `Sealshot's solid fill is an annotation drawn over the image, and a .seal
   package keeps the original capture alongside it so that edits stay reversible.
   Redaction is therefore destroyed in a flattened export — PNG, JPEG, or a
   flattened package — but not inside an editable project. Send exports, not
   editable packages, when the content matters.`,
  `Per TechSmith's 2025 move to annual subscription pricing, for the individual
   plan. Business and volume licensing may differ.`,
  `Shottr's own documentation warns that its hosted links are public and are not
   secure storage.`,
  `Xnapper's homepage says cloud sharing is “coming soon” while its changelog says
   image and video sharing have shipped. Needs checking against the current build.`,
];

const CARD_ORDER = [APPS[4], APPS[0], APPS[1], APPS[2], APPS[3]];

const ELSEWHERE = [
  ['You need Windows', 'Snagit is the only one here that runs on it.'],
  ['You want it free', 'Shottr and Xnapper both have real free tiers. Sealshot has a 14-day trial and then costs money.'],
  ['You want a share link', 'CleanShot Cloud, Shottr Cloud, or a team tool like Zight, Droplr, or Monosnap. Sealshot hosts nothing, so there is no URL to send.'],
  ['You want the widest automatic detection', 'Snagit finds more categories than we do — faces, dates, phone numbers and street addresses among them.'],
  ['Presentation screenshots are the job', 'Xnapper exists for exactly that, and records video too now.'],
  ['You manage seats for a team', 'Snagit’s business plans, or the team tools above. Sealshot has no per-seat administration.'],
];

const CHECKS = [
  ['Watch the network', 'Point Little Snitch, Proxyman, or tcpdump at any of these for an hour of real work — capture, edit, search, export, and every AI feature. What it contacts, and when, is a fact rather than a claim.'],
  ['Attack your own redaction', 'Redact something, export it, then try to get it back: zoom, push levels and contrast, run OCR over it, open it in another editor. Do it separately for the flattened export and for the editable project file — in every tool here, including this one, those are not the same thing.'],
  ['Pull the plug', 'Install on a machine with no network and try to work. Then try activating a paid license offline.'],
  ['Read the privacy policy for specifics', 'Look for one that names each network request rather than describing a posture. Vague is not the same as harmless.'],
];
---

<SiteLayout
  title="Sealshot compared — Mac screenshot apps, feature by feature"
  description="How Sealshot compares with CleanShot X, Snagit, Shottr, and Xnapper on capture, redaction, encryption, sharing, and price — from each vendor's own documentation, with sources and a checked-on date."
>
  <section class="section wrap" aria-labelledby="cmp-title">
    <p class="kicker">Comparison</p>
    <h1 id="cmp-title">Sealshot compared</h1>
    <p class="sub">
      Five Mac screenshot tools, feature by feature, from each vendor's own
      documentation rather than from a round-up. Where a vendor's pages are
      silent or disagree, this table says so instead of guessing.
    </p>

    <p class="cmp-checked">Information checked {CHECKED_ON}.</p>

    <dl class="cmp-legend">
      {LEGEND.map(([term, meaning]) => (
        <>
          <dt>{term}</dt>
          <dd>{meaning}</dd>
        </>
      ))}
    </dl>

    <div class="cmp-scroll">
      <table class="cmp">
        <caption class="visually-hidden">
          Feature comparison of CleanShot X, Snagit, Shottr, Xnapper, and Sealshot
        </caption>
        <thead>
          <tr>
            <th scope="col">Feature</th>
            {APPS.map((a) => (
              <th scope="col" class={a.ours ? 'is-ours' : undefined}>{a.name}</th>
            ))}
          </tr>
        </thead>
        {GROUPS.map((g) => (
          <tbody>
            <tr class="cmp-group">
              <th scope="colgroup" colspan={APPS.length + 1}>{g.title}</th>
            </tr>
            {g.rows.map((r) => (
              <tr>
                <th scope="row">{r.label}</th>
                {APPS.map((a) => (
                  <td class={a.ours ? 'is-ours' : undefined}>
                    {r[a.key]}
                    {r[a.key + 'Note'] && (
                      <sup><a href={`#note-${r[a.key + 'Note']}`}>{r[a.key + 'Note']}</a></sup>
                    )}
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        ))}
      </table>
    </div>

    <div class="cmp-cards">
      {CARD_ORDER.map((a) => (
        <article class={a.ours ? 'cmp-card is-ours' : 'cmp-card'}>
          <h2>{a.name}</h2>
          {GROUPS.map((g) => (
            <>
              <p class="cmp-card-group">{g.title}</p>
              <dl>
                {g.rows.map((r) => (
                  <>
                    <dt>{r.label}</dt>
                    <dd>
                      {r[a.key]}
                      {r[a.key + 'Note'] && (
                        <sup><a href={`#note-${r[a.key + 'Note']}`}>{r[a.key + 'Note']}</a></sup>
                      )}
                    </dd>
                  </>
                ))}
              </dl>
            </>
          ))}
        </article>
      ))}
    </div>

    <ol class="cmp-notes">
      {NOTES.map((n, i) => <li id={`note-${i + 1}`}>{n}</li>)}
    </ol>

    <h2 id="sources">Sources</h2>
    <ul class="cmp-sources">
      {APPS.filter((a) => !a.ours).map((a) => (
        <li>
          <strong>{a.name}</strong> —
          {a.sources.map(([label, url], i) => (
            <>{i > 0 ? ' · ' : ' '}<a href={url} rel="nofollow noopener">{label}</a></>
          ))}
        </li>
      ))}
    </ul>
    <p class="cmp-note-foot">
      Prices are the publicly listed individual ones and exclude tax. Something
      out of date or wrong? <a href="/support/">Tell us</a> — we would rather fix
      it than defend it.
    </p>

    <h2 id="elsewhere">When one of the others is the better buy</h2>
    <p>
      A comparison with nothing but wins in our own column would not be worth
      reading. These are the cases where we would point you elsewhere:
    </p>
    <dl class="cmp-else">
      {ELSEWHERE.map(([when, what]) => (
        <>
          <dt>{when}</dt>
          <dd>{what}</dd>
        </>
      ))}
    </dl>

    <h2 id="checks">How to check any of this yourself</h2>
    <p>
      Every tool in this category says it respects your privacy. These are the
      tests that turn that into something you can see — and they work on us as
      well as on them.
    </p>
    <dl class="cmp-else">
      {CHECKS.map(([title, how]) => (
        <>
          <dt>{title}</dt>
          <dd>{how}</dd>
        </>
      ))}
    </dl>

    <p class="cmp-note-foot">
      Not compared here: the screenshot tool built into macOS, which is free and
      on every Mac — if ⌘⇧5 already does what you need, use it. Nor the
      link-first team tools (Zight, Droplr, Monosnap), which solve sharing rather
      than capture.
    </p>
  </section>
</SiteLayout>

<style>
  .cmp-checked { font-size: 0.85rem; color: var(--slate-600); margin: 0.75rem 0 1.25rem; }

  .cmp-legend {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.2rem 0.9rem;
    max-width: 40rem;
    margin: 0 0 1.75rem;
    font-size: 0.85rem;
    padding: 0.9rem 1rem;
    background: var(--surface-footer);
    border-radius: var(--radius);
  }

  .cmp-legend dt { font-weight: 600; white-space: nowrap; }
  .cmp-legend dd { margin: 0; color: var(--slate-600); }

  .cmp-scroll { overflow-x: auto; margin: 0 0 1rem; }
  .cmp { border-collapse: collapse; width: 100%; min-width: 58rem; font-size: 0.88rem; }

  .cmp th,
  .cmp td {
    text-align: left;
    vertical-align: top;
    padding: 0.55rem 0.7rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .cmp thead th { border-bottom: 2px solid var(--navy-900); font-size: 0.95rem; }
  .cmp tbody th { font-weight: 600; color: var(--navy-900); width: 14rem; }
  .cmp td { color: var(--slate-600); }

  .cmp-group th {
    background: var(--surface-tint);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--navy-900);
    width: auto;
  }

  /* Our column is tinted and nothing else. Emphasis applied only to our own
     favourable cells makes the whole table read as advocacy. */
  .cmp .is-ours { background: var(--surface-band); color: var(--navy-900); }
  .cmp thead .is-ours { color: var(--orange-700); }

  .cmp sup { font-size: 0.7rem; }
  .cmp sup a { padding-left: 0.15rem; }

  .cmp-cards { display: none; }

  .cmp-notes {
    max-width: 46rem;
    margin: 0 0 2rem;
    padding-left: 1.2rem;
    font-size: 0.85rem;
    color: var(--slate-600);
  }

  .cmp-notes li { margin-bottom: 0.5rem; }
  .cmp-notes li:target { background: var(--mint-50); }

  .section h2 { font-size: 1.3rem; margin: 2rem 0 0.5rem; }

  .cmp-sources {
    max-width: 46rem;
    margin: 0.5rem 0 0.75rem;
    padding-left: 1.2rem;
    font-size: 0.9rem;
    color: var(--slate-600);
  }

  .cmp-sources li { margin-bottom: 0.3rem; }
  .cmp-note-foot { color: var(--slate-600); font-size: 0.9rem; max-width: 46rem; }
  .cmp-else { max-width: 46rem; margin: 1rem 0 0; }
  .cmp-else dt { font-weight: 600; margin-top: 0.9rem; }
  .cmp-else dd { margin: 0.2rem 0 0; color: var(--slate-600); }

  /* Six columns in 350px is unreadable however far it scrolls. One card per app
     instead, ours first, since nobody swipes sideways to reach a fifth column. */
  @media (max-width: 60rem) {
    .cmp-scroll { display: none; }
    .cmp-cards { display: grid; gap: 1rem; margin: 0 0 1.5rem; }

    .cmp-card {
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius);
      box-shadow: var(--shadow-card);
      padding: 1.25rem;
    }

    .cmp-card.is-ours { background: var(--surface-band); border-color: var(--orange-600); }
    .cmp-card h2 { font-size: 1.15rem; margin: 0 0 0.5rem; }
    .cmp-card.is-ours h2 { color: var(--orange-700); }

    .cmp-card-group {
      font-size: 0.7rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--orange-700);
      margin: 1rem 0 0.25rem;
      border-top: 1px solid var(--border-subtle);
      padding-top: 0.6rem;
    }

    .cmp-card dl { margin: 0; }
    .cmp-card dt { font-size: 0.8rem; color: var(--slate-400); margin-top: 0.55rem; }
    .cmp-card dd { margin: 0; font-size: 0.95rem; }
  }
</style>
