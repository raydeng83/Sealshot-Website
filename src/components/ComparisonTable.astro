---
import comparison from '../data/comparison.json';

/*
  The comparison table, shared by /compare and the landing page so the facts and
  the styling exist once. Data comes from src/data/comparison.json — edit it there,
  or edit the Excel export and run output/import-comparison-xlsx.py. The rules for
  what may go in a cell are in that file's _comment.

  On screens under 60rem this becomes one card per app instead of a table: six
  columns in 350px is unreadable however far it scrolls, and nobody swipes sideways
  to reach a fifth column.
*/

const { apps: APPS, groups: GROUPS, highlight: HIGHLIGHT } = comparison;

const isHighlight = (label: string, key: string) =>
  HIGHLIGHT && label === HIGHLIGHT.label && key === HIGHLIGHT.app;

// Cards lead with ours; the table ends with it.
const CARD_ORDER = [...APPS].reverse().sort((a, b) => (b.ours ? 1 : 0) - (a.ours ? 1 : 0));
---

<div class="cmp-scroll">
  <table class="cmp">
    <caption class="visually-hidden">
      Feature comparison of {APPS.map((a) => a.name).join(', ')}
    </caption>
    <thead>
      <tr>
        <th scope="col">Feature</th>
        {APPS.map((a) => (
          <th scope="col" class={a.ours ? 'is-ours' : undefined}>{a.name}</th>
        ))}
      </tr>
    </thead>
    {GROUPS.map((g) => (
      <tbody>
        <tr class="cmp-group">
          <th scope="colgroup" colspan={APPS.length + 1}>{g.title}</th>
        </tr>
        {g.rows.map((r) => (
          <tr>
            <th scope="row">{r.label}</th>
            {APPS.map((a) => (
              <td class={[a.ours ? 'is-ours' : '',
                          isHighlight(r.label, a.key) ? 'is-highlight' : '']
                .filter(Boolean).join(' ') || undefined}>{r[a.key]}</td>
            ))}
          </tr>
        ))}
      </tbody>
    ))}
  </table>
</div>

<div class="cmp-cards">
  {CARD_ORDER.map((a) => (
    <article class={a.ours ? 'cmp-card is-ours' : 'cmp-card'}>
      <p class="cmp-card-name">{a.name}</p>
      {GROUPS.map((g) => (
        <>
          <p class="cmp-card-group">{g.title}</p>
          <dl>
            {g.rows.map((r) => (
              <>
                <dt>{r.label}</dt>
                <dd class={isHighlight(r.label, a.key) ? 'is-highlight' : undefined}>
                  {r[a.key]}
                </dd>
              </>
            ))}
          </dl>
        </>
      ))}
    </article>
  ))}
</div>

<style>
  .cmp-scroll { overflow-x: auto; margin: 0 0 1rem; }
  .cmp { border-collapse: collapse; width: 100%; min-width: 58rem; font-size: 0.88rem; }

  .cmp th,
  .cmp td {
    text-align: left;
    vertical-align: top;
    padding: 0.55rem 0.7rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .cmp thead th { border-bottom: 2px solid var(--navy-900); font-size: 0.95rem; }
  .cmp tbody th { font-weight: 600; color: var(--navy-900); width: 14rem; }
  .cmp td { color: var(--slate-600); }

  .cmp-group th {
    background: var(--surface-tint);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--navy-900);
    width: auto;
  }

  /* White gap after each section. A thick border in the page colour is what makes
     it genuinely white: padding would be coloured in by the tinted Sealshot column
     and the section band. Skipped on the last section so the table does not end in
     a gap. */
  .cmp tbody:not(:last-of-type) tr:last-child th,
  .cmp tbody:not(:last-of-type) tr:last-child td {
    border-bottom: 14px solid var(--surface-page);
  }

  /* Our column is tinted and nothing else. Emphasis applied only to our own
     favourable cells makes the whole table read as advocacy. */
  .cmp .is-ours { background: var(--surface-band); color: var(--navy-900); }
  .cmp thead .is-ours { color: var(--orange-700); }

  /* The one cell allowed to shout: price is the argument the table is making. */
  .cmp td.is-highlight {
    background: var(--mint-50);
    color: var(--navy-900);
    font-weight: 700;
    font-size: 0.95rem;
    border-left: 3px solid var(--orange-600);
  }

  .cmp-cards { display: none; }

  @media (max-width: 60rem) {
    .cmp-scroll { display: none; }
    .cmp-cards { display: grid; gap: 1rem; margin: 0 0 1.5rem; }

    .cmp-card {
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius);
      box-shadow: var(--shadow-card);
      padding: 1.25rem;
    }

    .cmp-card.is-ours { background: var(--surface-band); border-color: var(--orange-600); }

    /* A paragraph, not a heading: this component is dropped into pages that own
       their own outline, and five h2s of app names would wreck it. */
    .cmp-card-name { font-size: 1.15rem; font-weight: 700; margin: 0 0 0.5rem; }
    .cmp-card.is-ours .cmp-card-name { color: var(--orange-700); }

    .cmp-card-group {
      font-size: 0.7rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--orange-700);
      margin: 1rem 0 0.25rem;
      border-top: 1px solid var(--border-subtle);
      padding-top: 0.6rem;
    }

    .cmp-card dl { margin: 0; }
    .cmp-card dt { font-size: 0.8rem; color: var(--slate-400); margin-top: 0.55rem; }
    .cmp-card dd { margin: 0; font-size: 0.95rem; }

    .cmp-card dd.is-highlight {
      font-weight: 700;
      color: var(--orange-700);
      background: var(--mint-50);
      border-left: 3px solid var(--orange-600);
      padding: 0.35rem 0.5rem;
      margin: 0.15rem 0 0;
      border-radius: 0 4px 4px 0;
    }
  }
</style>
