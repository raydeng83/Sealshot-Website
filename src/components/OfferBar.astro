---
import {
  activeOffer, formatUSD, savingsPercent, REGULAR_PRICE_CENTS, REGULAR_UPDATE_MONTHS,
} from '../config/promos';

/*
  The sitewide founding-price bar. It exists because the offer was only legible
  to someone who reached /buy: everywhere else "founding price" was a two-word
  label with no expiry, no comparison, and no saving attached to it.

  Every figure is derived from the active offer, so this cannot drift from what
  the Buy button charges, and it renders nothing at all once the window closes —
  there is no bar to remember to take down.

  Deliberately without a dismiss button: that needs client JS and per-visitor
  state, and a slim two-clause bar does not earn either. If it turns out to
  annoy, dismissal is a small addition later.

  Styles are local rather than in global.css because the docs run on Starlight
  and never load that file. The marketing tokens get fallbacks for the same
  reason — inside the docs, `--orange-700` and friends do not exist.
*/

const offer = activeOffer(new Date());
const percent = offer ? savingsPercent(offer.priceCents) : 0;
---

{offer && (
  <div class="offer-bar">
    <p>
      <strong>{offer.label}</strong>
      <span class="lede">
        {formatUSD(offer.priceCents)} instead of {formatUSD(REGULAR_PRICE_CENTS)} — {percent}% off
      </span>
      {/* The update window is the half people miss: founding is longer, not just
          cheaper. First to go on a narrow screen all the same, since the price is
          what earns the click. */}
      <span class="detail">
        , with {offer.updateMonths} months of updates instead of {REGULAR_UPDATE_MONTHS}
      </span>
      <span class="until">
        {/* No date, and no countdown: endsAt in promos.ts is still a placeholder,
            so a timer would count down to a made-up day. "Ending soon" only stays
            true while 1.0 actually is near — if the release slips, this is the
            line to change. */}
        · Ending soon
      </span>
      <a href="/buy/">Get it</a>
    </p>
  </div>
)}

<style>
  .offer-bar {
    background: var(--orange-700, #c2410c);
    color: #ffffff;
    font-size: 0.9rem;
    line-height: 1.4;
  }

  .offer-bar p {
    margin: 0 auto;
    max-width: var(--max-width, 72rem);
    padding: 0.5rem 1.5rem;
    display: flex;
    align-items: baseline;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0 0.4rem;
    text-align: center;
  }

  /* Only the clause that begins with a comma: the flex gap would otherwise land
     between "50% off" and ", with 18 months". The label above it keeps its gap. */
  .detail {
    margin-inline-start: -0.4rem;
  }

  .offer-bar strong {
    font-weight: 700;
    letter-spacing: 0.01em;
  }

  .offer-bar .until {
    opacity: 0.85;
  }

  .offer-bar a {
    color: #ffffff;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .offer-bar a:hover {
    text-decoration-thickness: 2px;
  }

  /* Below this the full sentence runs to three lines and starts reading as a
     paragraph. Price, saving and the link survive; the update window is on /buy
     and in the bar on wider screens. */
  @media (max-width: 52rem) {
    .offer-bar .detail {
      display: none;
    }
  }

  @media (max-width: 30rem) {
    .offer-bar {
      font-size: 0.85rem;
    }

    .offer-bar p {
      padding-inline: 1rem;
    }
  }
</style>
