---
import { Image } from 'astro:assets';
import icon from '../assets/icon.png';
---

<header class="site-header">
  <a class="brand" href="/">
    <Image src={icon} alt="" width={32} height={32} />
    <span>Sealshot</span>
  </a>
  <nav aria-label="Main">
    <a href="/#features">Features</a>
    <a href="/docs/">Docs</a>
    <a href="/support/">Support</a>
    <!-- Buy is outlined, Download filled: the free trial stays the primary
         entry point, and two filled pills would compete rather than rank. -->
    <a class="cta outline" href="/buy/">Buy</a>
    <a class="cta" href="/download/">Download</a>
  </nav>
</header>
