    .preview { width: 84%; }
    .tools .sort { display: none; }
    .heading strong { font-size: 1.2em; }
  }

  /* An element cannot answer its own container query, so the frame's shape is a
     media query. The threshold matches: inside `.section.wrap` the stage is the
