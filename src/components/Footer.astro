---
import NewsletterForm from './NewsletterForm.astro';
import { latestChangelogHref } from '../lib/changelog';
const hasNewsletter = Boolean(import.meta.env.PUBLIC_KIT_FORM_ID);
// Both changelog links below were hardcoded to v0-4-0 — six releases stale, so
// "Changelog" and "Follow the changelog" sent readers to the oldest notes we have.
const changelogHref = latestChangelogHref();
---

<footer class="site-footer">
  <div class="wrap">
    <div class="cols">
      <div>
        <h2>Product</h2>
        <ul>
          <li><a href="/#features">Features</a></li>
          <li><a href="/compare/">How to choose</a></li>
          <li><a href="/download/">Download</a></li>
          <li><a href={changelogHref}>Changelog</a></li>
        </ul>
      </div>
      <div>
        <h2>Resources</h2>
        <ul>
          <li><a href="/docs/">Documentation</a></li>
          <li><a href="/docs/faq/">FAQ</a></li>
          <li><a href="/support/">Support &amp; feedback</a></li>
          <li><a href="/refunds/">Refunds</a></li>
          <li><a href="/privacy/">Privacy</a></li>
        </ul>
      </div>
      <div>
        <h2>Stay in the loop</h2>
        <p class="fine-print">News, releases, offers, and tips.</p>
        {hasNewsletter ? <NewsletterForm /> : <p class="fine-print"><a href={changelogHref}>Follow the changelog</a> for what's new.</p>}
      </div>
    </div>
    <p class="legal">
      Sealshot — privacy-first screenshots for macOS 14+. No account, no
      telemetry, no cloud.
    </p>
  </div>
</footer>
