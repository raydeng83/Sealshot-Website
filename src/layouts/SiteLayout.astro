---
import '../styles/global.css';
import Header from '../components/Header.astro';
import SupportBar from '../components/SupportBar.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  /** Keep the page out of search results. For pages that only make sense when
      you arrive from somewhere specific — a confirmation link, a receipt. */
  noindex?: boolean;
  /** Suppress the sitewide support bar. For the page reached *after* buying,
      where being asked to support the product is at best noise, and for /buy,
      whose own headline already says both halves of what the bar says. */
  hideBar?: boolean;
}

const { title, description, noindex = false, hideBar = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="icon" href="/favicon.png" />
    {/* The docs get one from Starlight; these pages had none. Built from the
        pathname only, so the query strings we ourselves add — /support/?sent=1,
        /renew/?…, anything UTM-tagged from a campaign — all collapse to one
        canonical URL instead of looking like separate pages. */}
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL('/og-image.png', Astro.site)} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL('/og-image.png', Astro.site)} />
  </head>
  <body>
    <a class="visually-hidden skip-link" href="#main-content">Skip to content</a>
    {/* Above the header so the model is the first thing on the page, and after
        the skip link so it never stands between a keyboard user and the content.
        Unlike the offer bar it replaces, this renders on every page that does not
        opt out — the sentence is true whether or not an offer is running. */}
    {!hideBar && <SupportBar />}
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>
