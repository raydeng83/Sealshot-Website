---
import '../styles/global.css';
import Header from '../components/Header.astro';
import OfferBar from '../components/OfferBar.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  /** Keep the page out of search results. For pages that only make sense when
      you arrive from somewhere specific — a confirmation link, a receipt. */
  noindex?: boolean;
  /** Suppress the founding-price bar. For pages reached *after* buying, where
      "Founding price — get it" is at best noise and at worst suggests the visitor
      has just missed something. */
  hideOffer?: boolean;
}

const { title, description, noindex = false, hideOffer = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="icon" href="/favicon.png" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL('/og-image.png', Astro.site)} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL('/og-image.png', Astro.site)} />
  </head>
  <body>
    <a class="visually-hidden skip-link" href="#main-content">Skip to content</a>
    {/* Above the header so the offer is the first thing on the page, and after
        the skip link so it never stands between a keyboard user and the content.
        Renders nothing when no offer is running. */}
    {!hideOffer && <OfferBar />}
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>
